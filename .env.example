# Copy to ~/.config/mac-sandbox-control/host.env; do not store credentials here.
# Node's --env-file loader reads this for installed host commands and services.
SANDBOX_PUBLIC_HOST=mac-host.local
SANDBOX_MCP_BIND=127.0.0.1
SANDBOX_MCP_PORT=8788
SANDBOX_API=http://127.0.0.1:8787

# Opt-in only: relay AND native upstream may bind ALL interfaces; firewall both.
# Install optional Python dependencies first; see docs/desktop-relay.md.
SANDBOX_DESKTOP_ENABLED=0
# SANDBOX_DESKTOP_PYTHON=/absolute/path/to/desktop-venv/bin/python
# SANDBOX_DESKTOP_FPS=15  # target cap, 1–30; actual throughput depends on guest/viewer/network

# Optional absolute paths; omit to use the current user's standard directories.
# LUME_BIN=/opt/homebrew/bin/lume
# SANDBOX_STATE_ROOT=/absolute/private/path/mac-sandboxes
# SANDBOX_VM_STORAGE=/absolute/path/to/lume-storage

# Client-side (set on the client, not as an access token in this file):
# MAC_SANDBOX_URL=https://mac-host.example-tailnet.ts.net/mcp
# MAC_SANDBOX_TOKEN_FILE=/absolute/private/path/token
